# Google Cloud project registered for Earth Engine
EE_PROJECT=your-gcp-project-id
# Service account auth (leave empty to use `earthengine authenticate` locally)
EE_SERVICE_ACCOUNT=
EE_KEY_FILE=
# FeatureCollection asset of labelled points with an integer property "class"
TRAINING_ASSET=projects/your-project/assets/assam_training_points
# Year the training points represent
TRAIN_YEAR=2021
CORS_ORIGINS=http://localhost:8080
